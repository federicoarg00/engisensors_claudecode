# EngiSensors Environment Configuration
# Copy this file to .env and update with your actual values

# Application
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=DEBUG
SECRET_KEY=your-secret-key-change-this-in-production
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://engisensors:password@localhost:5432/engisensors
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# MQTT Broker Configuration
MQTT_BROKER_HOST=www.trustcapsupes.com
MQTT_BROKER_PORT=1883
MQTT_BROKER_USERNAME=
MQTT_BROKER_PASSWORD=
MQTT_CLIENT_ID=engisensors-backend
MQTT_KEEPALIVE=60
MQTT_QOS=1
MQTT_BASE_TOPIC=engisensors/#

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Notifications (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@engisensors.com
SENDGRID_FROM_NAME=EngiSensors Alert System

# SMS Notifications (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Alert Configuration
ALERT_THROTTLE_SECONDS=300
DEFAULT_GAS_THRESHOLD_PPM=800
MAX_CONTACTS_PER_CLIENT=10

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
